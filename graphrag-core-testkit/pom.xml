<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.rabauer.graphrag</groupId>
    <artifactId>graphrag-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <groupId>dev.rabauer.graphrag</groupId>
  <artifactId>graphrag-core-testkit</artifactId>
  <version>${graphrag-core.version}</version>
  <packaging>jar</packaging>

  <name>GraphRAG Lens :: Core Testkit</name>
  <description>
    Contract tests a third-party adapter of graphrag-core extends to prove it
    behaves correctly (GraphReadPortContract, GraphStorePortContract,
    VectorStorePortContract, EmbeddingPortContract), a reference in-memory
    GraphStorePort, and a code-graph fixture with its retrieval scenario.
    Use it with test scope.
  </description>

  <url>https://github.com/JohannesRabauer/graph-rag-visualisation</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>Johannes Rabauer</name>
      <url>https://github.com/JohannesRabauer</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/JohannesRabauer/graph-rag-visualisation.git</connection>
    <developerConnection>scm:git:https://github.com/JohannesRabauer/graph-rag-visualisation.git</developerConnection>
    <url>https://github.com/JohannesRabauer/graph-rag-visualisation</url>
  </scm>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>5.14.4</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>dev.rabauer.graphrag</groupId>
      <artifactId>graphrag-core</artifactId>
      <version>${graphrag-core.version}</version>
    </dependency>
    <!-- The contracts are JUnit 5 test classes shipped as main code, so JUnit is a compile dependency here. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>ban-framework-dependencies</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.springframework*:*</exclude>
                    <exclude>org.neo4j.driver:*</exclude>
                    <exclude>dev.langchain4j:*</exclude>
                  </excludes>
                  <message>graphrag-core-testkit must stay framework-free like graphrag-core: no Spring, Neo4j Java Driver, or LangChain4j dependency is allowed here.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
