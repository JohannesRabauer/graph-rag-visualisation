<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Deliberately has no <parent>, like graphrag-core: it is published to Maven
    Central together with the core (same version, one Portal deployment), and
    a published POM must not point to the unpublished graphrag-parent. It
    targets Java 21 like the core. Keep <version> equal to graphrag-core's.
  -->
  <groupId>dev.rabauer.graphrag</groupId>
  <artifactId>graphrag-core-testkit</artifactId>
  <version>2.1.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>GraphRAG Lens :: Core Testkit</name>
  <description>
    Contract tests a third-party adapter of graphrag-core extends to prove it
    behaves correctly (GraphReadPortContract, GraphStorePortContract,
    VectorStorePortContract, EmbeddingPortContract), a reference in-memory
    GraphStorePort, and a code-graph fixture with its retrieval scenario.
    Use it with test scope.
  </description>

  <url>https://github.com/JohannesRabauer/graph-rag-visualisation</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>JohannesRabauer</id>
      <name>Johannes Rabauer</name>
      <url>https://github.com/JohannesRabauer</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/JohannesRabauer/graph-rag-visualisation.git</connection>
    <developerConnection>scm:git:https://github.com/JohannesRabauer/graph-rag-visualisation.git</developerConnection>
    <url>https://github.com/JohannesRabauer/graph-rag-visualisation</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>5.14.4</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>dev.rabauer.graphrag</groupId>
      <artifactId>graphrag-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The contracts are JUnit 5 test classes shipped as main code, so JUnit is a compile dependency here. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
        <configuration>
          <release>${java.version}</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>require-java-21</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[21,)</version>
                  <message>graphrag-core-testkit requires JDK 21 or newer. Install JDK 21+ and make it the active JAVA_HOME/mvn toolchain.</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>ban-framework-dependencies</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.springframework*:*</exclude>
                    <exclude>org.neo4j.driver:*</exclude>
                    <exclude>dev.langchain4j:*</exclude>
                  </excludes>
                  <message>graphrag-core-testkit must stay framework-free like graphrag-core: no Spring, Neo4j Java Driver, or LangChain4j dependency is allowed here.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- Same opt-in Maven Central profile as graphrag-core (see its POM and RELEASING.md). -->
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <phase>package</phase>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.2</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <phase>package</phase>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <!-- The passphrase comes from MAVEN_GPG_PASSPHRASE; loopback
                       stops gpg from asking for it interactively in CI. -->
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <!-- <server> id in settings.xml holding the Portal user token. -->
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
              <waitUntil>validated</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
