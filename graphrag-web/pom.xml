<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.graphraglens</groupId>
    <artifactId>graphrag-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>graphrag-web</artifactId>
  <packaging>jar</packaging>

  <name>GraphRAG Lens :: Web</name>
  <description>
    Spring Boot + Thymeleaf web module (AD-15). No Node/npm tooling anywhere
    in this module or the repository.
  </description>

  <properties>
    <spring-boot.version>4.1.1</spring-boot.version>
    <playwright.version>1.56.0</playwright.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.graphrag</groupId>
      <artifactId>graphrag-core</artifactId>
      <version>${graphrag-core.version}</version>
    </dependency>
    <dependency>
      <groupId>com.graphraglens</groupId>
      <artifactId>graphrag-adapter-parsing</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.graphraglens</groupId>
      <artifactId>graphrag-adapter-langchain4j</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.graphraglens</groupId>
      <artifactId>graphrag-adapter-neo4j</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-thymeleaf</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!--
      Test-scope only, per AD-15 amendment (see ARCHITECTURE-SPINE.md):
      drives a real, already-installed Chromium (never downloaded by this
      build) to assert actual browser behavior for the vanilla JS this
      module ships (Replay scrubber, Explore node-tap/detail-panel,
      community-hull toggling) — none of which any `mvn test` run could
      previously catch. AD-15 still holds: no package.json, no npm install,
      no JS build/bundle step exists anywhere in this repository. Playwright
      itself bundles a Node-based automation driver as its runtime browser-
      control mechanism, invoked here purely as a Maven test dependency, not
      as an authoring/build toolchain for shipped frontend code.
    -->
    <dependency>
      <groupId>com.microsoft.playwright</groupId>
      <artifactId>playwright</artifactId>
      <version>${playwright.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>graphrag-web</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
