<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Deliberately has no <parent>: graphrag-core is published to Maven Central
    on its own, and a published POM must not point to a parent that is not
    published too. The root aggregator still builds it as a module; the few
    settings it used to inherit (Java release, encoding, plugin versions,
    the JDK 25 check) are repeated here.
  -->
  <groupId>dev.rabauer.graphrag</groupId>
  <artifactId>graphrag-core</artifactId>
  <version>2.0.0-SNAPSHOT</version>
  <packaging>jar</packaging>

  <name>GraphRAG Lens :: Core</name>
  <description>
    Framework-free GraphRAG core: domain model, port interfaces and use cases
    for ingestion, knowledge-graph extraction, community detection and
    Local, Global, DRIFT and vector-baseline search. Carries no dependency on
    any web framework, graph-database driver, or LLM-orchestration library.
  </description>

  <url>https://github.com/JohannesRabauer/graph-rag-visualisation</url>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>JohannesRabauer</id>
      <name>Johannes Rabauer</name>
      <url>https://github.com/JohannesRabauer</url>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:https://github.com/JohannesRabauer/graph-rag-visualisation.git</connection>
    <developerConnection>scm:git:https://github.com/JohannesRabauer/graph-rag-visualisation.git</developerConnection>
    <url>https://github.com/JohannesRabauer/graph-rag-visualisation</url>
    <tag>HEAD</tag>
  </scm>

  <properties>
    <java.version>25</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>5.14.4</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
        <configuration>
          <release>${java.version}</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>require-java-25</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[25,)</version>
                  <message>graphrag-core requires JDK 25 or newer. Install JDK 25 and make it the active JAVA_HOME/mvn toolchain.</message>
                </requireJavaVersion>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>ban-framework-dependencies</id>
            <phase>validate</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.springframework*:*</exclude>
                    <exclude>org.neo4j.driver:*</exclude>
                    <exclude>dev.langchain4j:*</exclude>
                  </excludes>
                  <message>graphrag-core must stay framework-free (AD-1): no Spring, Neo4j Java Driver, or LangChain4j dependency is allowed here.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <!--
    Everything Maven Central needs lives behind this opt-in profile, not the
    default build: routine `mvn install` runs (including CI on every push/
    PR) must not depend on Javadoc succeeding or on a GPG key being present.
    The release workflow (.github/workflows/release-core.yml) activates it;
    see RELEASING.md. `mvn deploy -Prelease` signs the artifacts and uploads
    them to the Central Portal, where the deployment waits for a manual
    "Publish" (autoPublish is off: a published version can never be removed).
  -->
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <phase>package</phase>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.2</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <phase>package</phase>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
                <configuration>
                  <!-- The passphrase comes from MAVEN_GPG_PASSPHRASE; loopback
                       stops gpg from asking for it interactively in CI. -->
                  <gpgArguments>
                    <arg>--pinentry-mode</arg>
                    <arg>loopback</arg>
                  </gpgArguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <!-- <server> id in settings.xml holding the Portal user token. -->
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
              <waitUntil>validated</waitUntil>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
